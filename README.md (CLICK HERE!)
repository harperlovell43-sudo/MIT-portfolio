main.cpp:
#include <iostream>
#include <string>
float input(); //lets you use input

int main()
{
	std::string operation{};
	std::cout << "select an operation {enter divide, multi, add, or sub}: " << '\n'; //what operation, ex: divide (divides num1 and num2)
	std::cin >> operation;
	std::cout << "\n";

	std::cout << "enter 2 numbers: "; //what 2 numbers you use
	float num1{ input() };
	float num2{ input() };
	float endingnum{};

	if (operation == "divide") //divides num1 by num2
	{
		endingnum = num1 / num2;
		std::cout << num1 << " / " << num2 << " = " << endingnum << '\n';
	}

	if (operation == "multi") //multiplies num1 by num 2
	{
		endingnum = num1 * num2;
		std::cout << num1 << " * " << num2 << " = " << endingnum << '\n';
	}
	
	if (operation == "add") //adds num1 to num2
	{
		endingnum = num1 + num2;
     	std::cout << num1 << " + " << num2 << " = " << endingnum << '\n';
	}
	if (operation == "sub") //subtracts num1 by num2;
	{
		endingnum = num1 - num2;
		std::cout << num1 << " - " << num2 << " = " << endingnum << '\n';

	}
	return 0;
}

